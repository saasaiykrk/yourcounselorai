# Copy to .env for local dev. In production these live in Google Secret Manager / Cloud Run secrets.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5          # PINNED. Change only with eval re-run + clinician sign-off.
SKILL_DIR=skill/clinical-assist        # the unzipped v2.1.1 .skill — source of truth
WHO_ICD_CLIENT_ID=
WHO_ICD_CLIENT_SECRET=
ICD_RELEASE=2025-01                    # PINNED ICD-11 MMS release; confirm latest at icd.who.int before Day 3
DATABASE_URL=postgresql://...          # Supabase, region ap-south-1 (Mumbai)
SUPABASE_JWKS_URL=https://<project>.supabase.co/auth/v1/.well-known/jwks.json
DAILY_TURN_LIMIT=40

# --- local dev only ---
DEV_MODE=0          # set to 1 for a keyless local smoke test via harness/ (never in production)
DEV_TOKEN=dev-L2    # harness bearer token; suffix picks the level (dev-L1 / dev-L2 / dev-L3)
HARNESS_PORT=5173
BACKEND_URL=http://127.0.0.1:8000
